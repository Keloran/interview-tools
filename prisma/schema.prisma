// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  clerkId          String            @unique
  email            String            @unique
  name             String?
  calendarUuid     String            @unique @default(uuid())
  companies        Company[]
  applications     Application[]
  stories          Story[]
  activityEntries  ActivityEntry[]
  staleAfterDays   Int               @default(60)
  communityConsent CommunityConsent?
  communityContributions CommunityContribution[]
  interviewCreateReceipts InterviewCreateReceipt[]
  storyCreateReceipts StoryCreateReceipt[]
}

model Company {
  id               Int               @id @default(autoincrement())
  name             String
  userId           Int
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications     Application[]
  created_at       DateTime          @default(now())

  @@unique([userId, name])
}

// Application represents a job application - the root entity for tracking
model Application {
  id                Int                @id @default(autoincrement())
  userId            Int
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         Int
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientCompany     String? // End client company (for recruitment agencies)
  jobTitle          String // Role you're applying for
  applicationDate   DateTime // When you applied for this job
  jobPostingLink    String? // URL of job posting
  viaRecruiter      Boolean            @default(false)
  recruiterName     String?
  recruiterEmail    String?
  recruiterLinkedIn String?
  firstResponseAt   DateTime?          @db.Date
  advertisedSalary  String?           @db.Text
  communityEmployerId String?
  communityEmployer CommunityEmployer? @relation(fields: [communityEmployerId], references: [id], onDelete: SetNull)
  communityEmployerConfirmedAt DateTime?
  communityEmployerChangedAt DateTime?
  communityEmployerIdentity String?
  interviews        Interview[]
  availabilityLinks AvailabilityLink[]
  followUps         FollowUp[]
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@unique([userId, companyId, jobTitle, applicationDate, clientCompany])
}

// You chased the company about an application
model FollowUp {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sentAt        DateTime    @default(now())
  clientMutationId String?

  @@unique([applicationId, clientMutationId])

  @@index([applicationId])
}

// Shareable "here's when I'm free" link for an application's next stage; booking a slot schedules it
model AvailabilityLink {
  id              String      @id @default(uuid())
  applicationId   Int
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId         Int
  stage           Stage       @relation(fields: [stageId], references: [id])
  durationMinutes Int         @default(60)
  meetingLink     String?
  slots           DateTime[]
  bookedSlot      DateTime?
  interviewId     Int?        @unique
  interview       Interview?  @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  // opens are counted from the browser, so link previews (Slack, LinkedIn, email) don't count
  viewCount       Int         @default(0)
  firstViewedAt   DateTime?
  lastViewedAt    DateTime?
  created_at      DateTime    @default(now())
  sentAt          DateTime?
}

model ActivityEntry {
  id       Int      @id @default(autoincrement())
  userId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  activity String
  employer String   @default("")
  role     String   @default("")
  how      String   @default("")
  outcome  String   @default("")
  notes    String   @default("") @db.Text

  @@index([userId, date])
}

// Interview represents a single interview stage within an application
model Interview {
  id              Int               @id @default(autoincrement())
  applicationId   Int
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId         Int
  stage           Stage             @relation(fields: [stageId], references: [id])
  stageMethodId   Int
  stageMethod     StageMethod       @relation(fields: [stageMethodId], references: [id])
  interviewer     String? // Name of person interviewing you
  date            DateTime? // When this interview stage is scheduled
  deadline        DateTime? // For take-home tests
  durationMinutes Int               @default(60) // used for buffers and the calendar feed end time
  outcome         InterviewOutcome?
  notes           String?           @db.Text
  link            String? // Meeting link (Teams, Google Meet, etc.)

  // Private offer details, kept as entered (currency, period and conditions included)
  offerBase       String? @db.Text
  offerBonus      String? @db.Text
  offerEquity     String? @db.Text
  offerBenefits   String? @db.Text
  offerNotice     String? @db.Text
  offerLocation   String? @db.Text

  // Debrief, written straight after the interview while it's fresh
  debriefedAt    DateTime?
  rating         Int? // how it went, 1-5
  debriefNotes   String?   @db.Text
  peopleMet      String?   @db.Text
  questionsAsked String?   @db.Text // one per line
  prepNotes      String?   @db.Text // for the next round
  nextStep       String? // what they said happens next
  replyBy        DateTime? // when they said you'd hear back

  // Did they say why? Mostly asked on rejection, can be added to any stage
  feedbackType FeedbackType?
  feedbackText String?       @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Parent-child for ordering within the application
  parentId         Int?
  parent           Interview?        @relation("InterviewChain", fields: [parentId], references: [id], onDelete: SetNull)
  children         Interview[]       @relation("InterviewChain")
  availabilityLink AvailabilityLink?
  stories          StoryUse[]

  @@map("InterviewStage") // New table name to avoid conflict
  createReceipt InterviewCreateReceipt?
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  situation String   @default("") @db.Text
  task      String   @default("") @db.Text
  action    String   @default("") @db.Text
  result    String   @default("") @db.Text
  tags      String[] @default([])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  interviews StoryUse[]
  createReceipt StoryCreateReceipt?

  @@index([userId])
}

model StoryUse {
  interviewId Int
  storyId     Int
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([interviewId, storyId])
  @@index([storyId])
}

model Stage {
  id                Int                @id @default(autoincrement())
  stage             String             @unique
  interviews        Interview[]
  availabilityLinks AvailabilityLink[]
}

model StageMethod {
  id               Int               @id @default(autoincrement())
  method           String            @unique
  interviews       Interview[]
}

enum FeedbackType {
  NONE // No feedback
  GENERIC // "We went with someone else"
  SPECIFIC // Something you can act on
}

enum InterviewOutcome {
  NO_RESPONSE // Explicitly closed as ghosted by the owner
  SCHEDULED // Interview is scheduled
  PASSED // You progressed to next stage
  REJECTED // You didn't get through
  AWAITING_RESPONSE // Waiting to hear back
  OFFER_RECEIVED // You got the job offer!
  OFFER_ACCEPTED // You accepted the offer
  OFFER_DECLINED // You declined the offer
  WITHDREW // You withdrew your application
}

// Singleton release controls. Publication and collection are separate, default-off gates.
model CommunityControl {
  id String @id @default("global")
  noticeVersion String?
  noticePublishedAt DateTime?
  collectionEnabled Boolean @default(false)
  publicationEnabled Boolean @default(false)
  revocationEpoch Int @default(0)
  lastPublicationMonth String?
}

// Latest choice only; cascades with the account. Never an analytics/event log.
model CommunityConsent {
  userId Int @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeVersion String
  grantedAt DateTime?
  withdrawnAt DateTime?
  revision Int @default(1)
  purgePending Boolean @default(false)
  quarantinedAt DateTime?
}

// Foundations for IT-81. No contributions or snapshots are created by the consent API.
model CommunityEmployer {
  id String @id @default(uuid())
  name String
  domain String?
  jurisdiction String?
  aliases String[] @default([])
  cohortReviewedAt DateTime?
  applications Application[]
  reviewedAt DateTime?
  suppressedAt DateTime?
  contributions CommunityContribution[]
  snapshot CommunitySnapshot?
}
model CommunityContribution {
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerId String
  employer CommunityEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  noticeVersion String
  consentRevision Int
  observedAt DateTime
  responded Boolean?
  ghosted Boolean?
  feedbackGiven Boolean?
  replyDays Int?
  @@id([userId, employerId])
}
model CommunitySnapshot {
  employerId String @id
  employer CommunityEmployer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  revocationEpoch Int
  noticeVersion String
  publishedAt DateTime
  data Json
}

// Retained after an interview is deleted so delayed retries cannot resurrect it.
model InterviewCreateReceipt {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutationId  String
  interviewId Int?       @unique
  interview   Interview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@unique([userId, mutationId])
}

model StoryCreateReceipt {
  id         Int    @id @default(autoincrement())
  userId     Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutationId String
  storyId    Int?   @unique
  story      Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@unique([userId, mutationId])
}
